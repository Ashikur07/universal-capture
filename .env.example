# ===== Universal Screenshot Capture: settings =====
# The first run copies this file to ".env". Change the values after "=" in .env.
# Lines starting with # are only notes.
# NEVER write passwords or OTPs here. Type them in the browser yourself.

# 1) Website link, e.g. https://example.com or http://localhost:3000
#    (leave empty to be asked every time)
URL=

# 2) Name of the screenshot folder (empty = website name)
PROJECT_NAME=

# 3) Screen type: mobile, tablet, desktop or custom
DEVICE=mobile

# Optional own size (use with DEVICE=custom). SCALE 1-4: higher = sharper, bigger files
WIDTH=
HEIGHT=
SCALE=

# 4) auto = save whenever the screen changes, manual = save only when you press F8
CAPTURE_MODE=auto

# true = the whole scrollable page in one image (normal websites)
# false = only what is visible (best for app prototypes)
FULL_PAGE=false

# How long the screen must stay still before it is saved, in milliseconds (300-10000)
WAIT_MS=1000

# Blur private parts of the page. Any CSS selector, for example:
# BLUR=.balance, #phone-number, input[type="email"]
# Best effort only: always check the images before you share them.
BLUR=

# true = stay logged in next time. The login is stored in the "profiles" folder,
# so never share that folder. false = it is deleted when you finish.
KEEP_LOGIN=false

# Where screenshots are saved
OUTPUT_DIR=screenshots

# Only if Chrome / Edge is not found automatically: full path to the browser program
BROWSER_PATH=
